# Local model used by the generation module.
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Number of chunks requested from retrieval.
REPWISE_TOP_K=5

# Local SQLite file used by the demo API.
REPWISE_DATABASE_PATH=data/repwise.sqlite3

# Optional chunk file for the JSONL baseline retriever.
REPWISE_CHUNK_FILE=

# FastAPI URL used by the Streamlit demo client.
REPWISE_API_URL=http://127.0.0.1:8000
