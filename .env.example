# Set a private random string before using registration or login.
REPWISE_AUTH_SECRET=replace-with-a-long-random-local-secret

# Point this to a JSONL chunk file in data/corpus/chunks after preparing the corpus.
REPWISE_CHUNK_FILE=
REPWISE_RETRIEVAL=hybrid
REPWISE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
REPWISE_EMBEDDING_INDEX=data/corpus/index/semantic.npz
REPWISE_TOP_K=5
REPWISE_DATABASE_PATH=data/repwise.sqlite3

OLLAMA_MODEL=llama3.2
OLLAMA_COMPARISON_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
REPWISE_API_URL=http://127.0.0.1:8000
