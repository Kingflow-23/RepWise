# RepWise local setup
# Copy this file to .env, then follow README.md to prepare the transcript chunks
# and semantic index, download the Ollama models, and start the API/UI.

# Private key for signing login tokens. Never commit your real key.
# Generate one in PowerShell with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Replace this placeholder in your local .env before registering or signing in.
REPWISE_AUTH_SECRET=replace-this-with-a-private-random-secret

# Path to any JSONL file inside the prepared chunks folder. The app loads every
# JSONL file in that same folder. Replace the example filename if yours differs.
REPWISE_CHUNK_FILE=data/corpus/chunks/05WPpiDdC78.jsonl

# Search strategy: bm25 (keyword only), semantic (meaning based), or hybrid.
# hybrid requires the embedding model and index configured below.
REPWISE_RETRIEVAL=hybrid
# Translate and expand each retrieval query in French using the local Ollama model.
REPWISE_QUERY_EXPANSION=true
REPWISE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
REPWISE_EMBEDDING_INDEX=data/corpus/index/semantic.npz

# How many relevant transcript chunks to provide as evidence for a plan.
REPWISE_TOP_K=5

# Local microphone transcription model. Downloaded on first use, then cached.
REPWISE_SPEECH_MODEL=base

# Local SQLite file for accounts, profiles, and saved plans.
REPWISE_DATABASE_PATH=data/repwise.sqlite3

# Optional: where the Google Calendar client file and tokens are kept.
# REPWISE_GOOGLE_DIR=data/google

# Main chat model used to generate workout plans.
# ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b

# Smaller local model used to translate and expand French retrieval queries.
# ollama pull qwen3.5:4b
OLLAMA_QUERY_EXPANSION_MODEL=qwen3.5:4b
OLLAMA_JUDGE_MODEL=qwen3.5:4b

# Optional second instruction-tuned chat model used only by the comparison
# benchmark.
# ollama pull gemma4:12b
OLLAMA_COMPARISON_MODEL=gemma4:12b

# Ollama server address (default for the local Windows Ollama app).
OLLAMA_BASE_URL=http://localhost:11434

# --- Multi-agent assistant ---------------------------------------------------
# Tool-calling model used by the orchestrator and the five specialists.
# Defaults to OLLAMA_MODEL when empty.
REPWISE_AGENT_MODEL=qwen3.5:9b
# Small model that decides whether text mentions pain, injury or a medical issue.
# Defaults to OLLAMA_QUERY_EXPANSION_MODEL. If it cannot answer, RepWise treats the
# text as a possible health concern (no automatic training change).
REPWISE_HEALTH_CHECK_MODEL=qwen3.5:4b
# Default time zone for dates and calendar slots (a request can override it).
REPWISE_TIMEZONE=Europe/Paris
# How long episodic memory (short records of past requests) is kept.
REPWISE_EPISODE_RETENTION_DAYS=90
# How long a proposed consequential action can still be approved.
REPWISE_APPROVAL_MINUTES=30
# Limits of one agent run. The defaults suit a local 9B model.
REPWISE_AGENT_MAX_DELEGATIONS=4
REPWISE_AGENT_MAX_REPLANS=1
REPWISE_AGENT_MAX_TOOL_CALLS=5
REPWISE_AGENT_REQUEST_SECONDS=420
REPWISE_AGENT_SPECIALIST_SECONDS=240
REPWISE_AGENT_CONTEXT_TOKENS=16384

# --- Location Agent (OpenStreetMap through Photon, no API key) ---------------
# Place names and coordinates are sent to this service when the student searches.
REPWISE_PHOTON_URL=https://photon.komoot.io
REPWISE_HTTP_USER_AGENT=RepWise-course-project

# --- MCP server (python -m src.mcp_server.server) ---------------------------
# Set privately by the MCP host after signing in through /api/v1/auth/login.
# The server refuses to start without a valid token. Never commit a real token.
# REPWISE_MCP_ACCESS_TOKEN=

# API address used by the Streamlit UI.
REPWISE_API_URL=http://127.0.0.1:8000

# Logging: DEBUG for detailed diagnostics, or INFO for normal operation.
# Logs are written to the terminal and rotated files under logs/.
REPWISE_LOG_LEVEL=INFO
REPWISE_LOG_DIR=logs
