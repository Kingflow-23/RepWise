{
  "tools": [
    {
      "name": "get_user_profile",
      "type": "read",
      "description": "Read a student's experience, goal, available_days, session_minutes, equipment, and preferences.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "student_id": {
            "description": "Account ID, as in the API's student routes.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "student_id"
        ]
      }
    },
    {
      "name": "get_timetable",
      "type": "read",
      "description": "Read a student's weekly availability and planned workouts, each with its plan_id, week_number, workout_index, and saved feedback.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "student_id": {
            "description": "Account ID, as in the API's student routes.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "student_id"
        ]
      }
    },
    {
      "name": "save_workout_feedback",
      "type": "write",
      "description": "Save feedback for one workout. Call only when the student explicitly asks to log it.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "student_id": {
            "description": "Account ID, as in the API's student routes.",
            "minLength": 1,
            "type": "string"
          },
          "plan_id": {
            "description": "A plan_id returned by get_timetable.",
            "minLength": 1,
            "type": "string"
          },
          "week_number": {
            "description": "A week_number returned by get_timetable.",
            "minimum": 1,
            "type": "integer"
          },
          "workout_index": {
            "description": "A zero-based workout_index returned by get_timetable.",
            "minimum": 0,
            "type": "integer"
          },
          "completion_status": {
            "description": "Whether the student finished the workout.",
            "enum": [
              "completed",
              "partially_completed",
              "not_completed"
            ],
            "type": "string"
          },
          "difficulty": {
            "description": "How the workout felt to the student.",
            "enum": [
              "much_too_easy",
              "slightly_too_easy",
              "just_right",
              "slightly_too_hard",
              "much_too_hard"
            ],
            "type": "string"
          },
          "comment": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional comment from the student."
          }
        },
        "required": [
          "student_id",
          "plan_id",
          "week_number",
          "workout_index",
          "completion_status",
          "difficulty"
        ]
      }
    }
  ]
}
